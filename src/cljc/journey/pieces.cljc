(defn height
  "How tall symbol t stands where one space is `unit` tall."
  [t unit]
  (* unit (get-in pieces [t :height] 0)))

(defn width
  "How wide symbol t is where one space is `unit` tall."
  [t unit]
  (* unit (get-in pieces [t :width] 0)))

(defn piece
  "Hiccup for one piece symbol, base at the origin, sized for a board space
   `unit` tall.  :fill is the body, :line the contour colour — omit it for a
   plain silhouette, which is what small sizes want."
  [t unit & [{:keys [fill line line-width]}]]
  (when-let [{:keys [outline lines]} (get pieces t)]
    [:g {:transform (str "scale(" unit ")")}
     [:path {:d outline :fill (or fill "currentColor")}]
     (when (and line (seq lines))
       [:path {:d lines :fill "none" :stroke line
               :stroke-width (or line-width 0.012)
               :stroke-linecap "round" :stroke-linejoin "round"}])]))
